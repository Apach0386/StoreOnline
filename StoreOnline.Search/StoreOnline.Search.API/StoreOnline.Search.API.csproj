    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.14.0-beta.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.14.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.14.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.14.0-beta.2" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.14.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\StoreOnline.Contracts\StoreOnline.Contracts.csproj" />
    <ProjectReference Include="..\StoreOnline.Domain.DependencyInjection\StoreOnline.Search.Domain.DependencyInjection.csproj" />
    <ProjectReference Include="..\StoreOnline.Search.Storage.DependencyInjection\StoreOnline.Search.Storage.DependencyInjection.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <Protobuf Include="..\..\StoreOnline.Contracts\product.proto" GrpcServices="Server"/>
  </ItemGroup>

</Project>
